# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# OPENAI_API_KEY: Optional/Supported OpenAI API key for OpenAI analyzer integration.
OPENAI_API_KEY="your_openai_api_key_here"

# JWT_SECRET: Secret for signing JWT authentication tokens.
JWT_SECRET="your_random_secret_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:5173"

# PORT: Server port (defaults to 3000 in this container)
PORT=3000

# VITE_API_URL: Base API URL for frontend (leave empty for relative /api)
VITE_API_URL="http://localhost:5000"
